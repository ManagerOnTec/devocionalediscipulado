# ── Django ────────────────────────────────────────────────────────────────────
DEBUG=True
# Gere uma nova chave: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta-segura
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Banco de Dados ────────────────────────────────────────────────────────────
# Opcao 1 — URL completa (Neon / Cloud SQL — producao/dev remoto)
# DATABASE_URL=postgresql://usuario:senha@ep-xxx.neon.tech/dbname?sslmode=require
# Opcao 2 — variaveis individuais (Docker Compose local); ignoradas se DATABASE_URL estiver definida
DB_NAME=devocionalediscipulado
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ── E-mail ────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
DEFAULT_FROM_EMAIL=noreply@devocional.com.br

# ── Sentry (monitoramento de erros em producao) ───────────────────────────────
SENTRY_DSN=

# ── Cloud Run / GCP ───────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False

# ── GCS (media uploads em producao) ──────────────────────────────────────────
# Deixe vazio para desativar GCS (usa armazenamento local)
GS_BUCKET_NAME=

# ── Gunicorn (producao) ───────────────────────────────────────────────────────
PORT=8080
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# ── Superusuario inicial (entrypoint.sh) ─────────────────────────────────────
DJANGO_SUPERUSER_EMAIL=admin@managerontecsolutions.com.br
DJANGO_SUPERUSER_PASSWORD=admin

# ── DockerHub / Cloud Run ─────────────────────────────────────────────────────
DOCKERHUB_IMAGE=dockerhub-user/devocionalediscipulado
CLOUD_RUN_SERVICE=devocionalediscipulado
CLOUD_RUN_REGION=southamerica-east1
